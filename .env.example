# Copie para .env e preencha. O .env não vai para o git.

# --- Banco (PostgreSQL gerenciado: Supabase, Neon, ...) ---

# Conexão via pooler — usada pela aplicação em runtime.
DATABASE_URL="postgresql://usuario:senha@host:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexão direta, sem pooler — usada por `prisma migrate` e pelo seed.
# O pooler em modo transaction derruba os advisory locks das migrações.
DIRECT_URL="postgresql://usuario:senha@host:5432/postgres"

# --- Autenticação ---

# Assina o cookie de sessão. Mínimo de 32 caracteres.
# Gere um valor novo com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=""

# --- Painel na TV ---

# Token que entra na própria URL: /painel/<PAINEL_TOKEN>
# Pode ser trocado a qualquer momento; a TV só precisa da URL nova.
# Gere com: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
PAINEL_TOKEN=""

# --- Seed (usado só ao rodar `npm run db:seed`) ---

SEED_ADMIN_NOME="Administrador"
SEED_ADMIN_EMAIL=""
SEED_ADMIN_SENHA=""
